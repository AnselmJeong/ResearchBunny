{
  "name": "researchbunny",
  "productName": "ResearchBunny",
  "version": "0.1.2",
  "description": "A local research library and citation discovery workspace",
  "main": "dist/main.cjs",
  "author": "ResearchBunny",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "node scripts/test.mjs",
    "test:desktop": "node tests/desktop/smoke.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "package": "npm run build && electron-forge package --arch=arm64 && node scripts/sign.mjs",
    "make": "npm run package && node scripts/make-dmg.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:navigation": "node tests/desktop/navigation.mjs",
    "test:design": "node tests/desktop/design.mjs"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "better-sqlite3": "13.0.3",
    "cytoscape": "3.34.3",
    "lucide-react": "1.48.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron/osx-sign": "1.3.3",
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/cytoscape": "3.21.9",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
