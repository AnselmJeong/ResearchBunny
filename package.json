{
  "name": "researchbunny",
  "productName": "ResearchBunny",
  "version": "0.3.17",
  "description": "A local research library and citation discovery workspace",
  "author": "ResearchBunny",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "bun scripts/build.ts && bun scripts/electrobun.ts build",
    "start": "bun run build && bun scripts/electrobun.ts dev",
    "dev": "bun run start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "bun scripts/build.ts && bun test tests/integration --timeout 60000",
    "test:desktop": "bun tests/desktop/electrobun-smoke.ts",
    "test:live": "bun scripts/live-smoke.mjs",
    "package": "bun scripts/build.ts && bun scripts/electrobun.ts build --env=stable",
    "make": "bun run package"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-tiling": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "cytoscape": "3.34.3",
    "d3-force": "3.0.0",
    "lucide-react": "1.48.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.8",
    "@types/cytoscape": "3.21.9",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "electrobun": "1.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
