{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "bun",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "tests/**/*.ts",
    "electrobun.config.ts",
    "scripts/**/*.ts"
  ]
}
